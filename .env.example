# ============================================================
# Wayfare — environment template. Copy to .env and fill in.
# .env is gitignored. NEVER commit real secrets.
# ============================================================

# --- PostgreSQL (single instance, database-per-service) ---
POSTGRES_USER=wayfare
POSTGRES_PASSWORD=wayfare
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kafka / Redpanda ---
KAFKA_BROKERS=localhost:19092

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Observability ---
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- JWT / RS256 keypair (generated into secrets/, gitignored) ---
JWT_PRIVATE_KEY_PATH=secrets/private.pem
JWT_PUBLIC_KEY_PATH=secrets/public.pem
JWT_ISSUER=https://api.wayfare.local
JWT_AUDIENCE=wayfare-api

# --- LLM provider (Itinerary AI Service) — provider-agnostic ---
# Swappable behind the LlmClient port. Pick ONE free provider.
# DEMO_MODE=true is the default: serves fixture itineraries, zero spend,
# no rate limits — the deployed public demo should stay on this.
DEMO_MODE=true

# Options: groq | gemini | ollama  (all have a free path)
LLM_PROVIDER=groq

# Groq — free, fast, OpenAI-compatible (https://console.groq.com/keys)
GROQ_API_KEY=gsk-replace-me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — free tier, native structured output (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash

# Ollama — fully local, no key, no cost (https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Per-user generation quota ---
GEN_QUOTA_PER_USER_PER_DAY=3
GEN_QUOTA_GLOBAL_PER_DAY=20
